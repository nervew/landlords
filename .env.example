NEXT_PUBLIC_SITE_URL=https://example.com
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-random-secret-with-at-least-32-characters
DATABASE_URL=postgresql://landlords_app:replace-me@127.0.0.1:5432/landlords

# Solo para tareas administrativas locales; no lo use la aplicación.
POSTGRES_ADMIN_URL=postgresql://postgres:replace-me@127.0.0.1:5432/postgres
DATABASE_ADMIN_URL=postgresql://postgres:replace-me@127.0.0.1:5432/landlords
APP_DATABASE_NAME=landlords
APP_DATABASE_USER=landlords_app
APP_DATABASE_PASSWORD=replace-me

# `preview` conserva el mensaje en PostgreSQL y solo se permite fuera de producción.
# Para entrega real use `smtp` y configure las dos variables siguientes.
EMAIL_DELIVERY_MODE=preview
SMTP_URL=smtps://usuario:clave-codificada@smtp.example.com:465
EMAIL_FROM=Raíz de Pueblo <no-responder@example.com>
